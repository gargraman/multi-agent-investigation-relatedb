# Copy is generated by `make secrets` into the repo-root .env (git-ignored). Never commit real values.
NEXUS_TOKEN_ORCHESTRATOR=
NEXUS_TOKEN_CONTEXT_SERVICE=
NEXUS_TOKEN_SIGINT_AGENT=
NEXUS_TOKEN_GEOINT_AGENT=
NEXUS_TOKEN_ANALYSIS_AGENT=
NEXUS_LOG_LEVEL=INFO
NEXUS_UI_PORT=3000
NEXUS_MAX_CONCURRENT_INVESTIGATIONS=20   # S1 only; spec default 2 from S3
# --- LLM (S2) ---------------------------------------------------------------------------
OPENAI_API_KEY=                                   # required when NEXUS_LLM_MODE=live
OPENAI_MODEL_EXTRACT=gpt-5.4-mini-2026-03-17      # pin a DATED snapshot: recordings store model_id
NEXUS_LLM_MODE=live                               # live | replay (restart to change; no runtime switch)
# SSL_CERT_FILE is read from your shell, not this file: a CA bundle for TLS-intercepting proxies,
# mounted into the agent as a compose secret (empty when unset).
