{
  "additionalProperties": false,
  "description": "Impact set: everything that depends on the retracted evidence, at any depth (\u00a710 I2).\nFindings and assessments are now ``NEEDS_REVIEW``; assertions drop out of I4 with their\nfindings (ADR-007 G11).",
  "properties": {
    "assertion_ids": {
      "items": {
        "type": "string"
      },
      "title": "Assertion Ids",
      "type": "array"
    },
    "assessment_ids": {
      "items": {
        "pattern": "^asm_[A-Za-z0-9_-]{1,64}$",
        "type": "string"
      },
      "title": "Assessment Ids",
      "type": "array"
    },
    "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Decision Id",
      "type": "string"
    },
    "evidence_id": {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$",
      "title": "Evidence Id",
      "type": "string"
    },
    "finding_ids": {
      "items": {
        "pattern": "^fnd_[A-Za-z0-9_-]{1,64}$",
        "type": "string"
      },
      "title": "Finding Ids",
      "type": "array"
    }
  },
  "required": [
    "evidence_id",
    "decision_id"
  ],
  "title": "RetractionImpact",
  "type": "object"
}
