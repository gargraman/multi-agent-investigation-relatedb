{
  "$defs": {
    "Classification": {
      "description": "Fictional demo classification levels (spec \u00a79.3).",
      "enum": [
        "DEMO-LOW",
        "DEMO-MID",
        "DEMO-HIGH"
      ],
      "title": "Classification",
      "type": "string"
    },
    "Observation": {
      "additionalProperties": false,
      "description": "One synthetic sighting of a subject at a raw point, in [observed_from, observed_until).",
      "properties": {
        "observation_id": {
          "title": "Observation Id",
          "type": "string"
        },
        "observed_from": {
          "format": "date-time",
          "title": "Observed From",
          "type": "string"
        },
        "observed_until": {
          "format": "date-time",
          "title": "Observed Until",
          "type": "string"
        },
        "subject": {
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "observation_id",
        "subject",
        "x",
        "y",
        "observed_from",
        "observed_until"
      ],
      "title": "Observation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "GEOINT evidence fixture.",
  "properties": {
    "classification": {
      "$ref": "#/$defs/Classification"
    },
    "evidence_id": {
      "title": "Evidence Id",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "schema": {
      "const": "nexus.fixture.geoint.sightings/1",
      "title": "Schema",
      "type": "string"
    },
    "sensor": {
      "minLength": 1,
      "title": "Sensor",
      "type": "string"
    },
    "summary": {
      "description": "Short, shareable summary.",
      "maxLength": 280,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "synthetic": {
      "const": true,
      "title": "Synthetic",
      "type": "boolean"
    }
  },
  "required": [
    "evidence_id",
    "synthetic",
    "classification",
    "summary",
    "schema",
    "sensor",
    "observations"
  ],
  "title": "SightingLog",
  "type": "object"
}
