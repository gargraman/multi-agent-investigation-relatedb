{
  "$defs": {
    "Conclusion": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "confidence_band": {
          "$ref": "#/$defs/ConfidenceBand"
        },
        "kind": {
          "$ref": "#/$defs/FindingKind"
        },
        "limitations": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "statement": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "supporting_finding_ids": {
          "items": {
            "pattern": "^fnd_[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Supporting Finding Ids",
          "type": "array"
        }
      },
      "required": [
        "statement",
        "kind",
        "confidence",
        "confidence_band",
        "supporting_finding_ids"
      ],
      "title": "Conclusion",
      "type": "object"
    },
    "ConfidenceBand": {
      "description": "Mandatory confidence band (spec \u00a79.2). Bands are documented, not calibrated.",
      "enum": [
        "LOW",
        "MODERATE",
        "HIGH"
      ],
      "title": "ConfidenceBand",
      "type": "string"
    },
    "Contradiction": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "effect_on_confidence": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Effect On Confidence",
          "type": "string"
        },
        "finding_ids": {
          "items": {
            "pattern": "^fnd_[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Finding Ids",
          "type": "array"
        }
      },
      "required": [
        "finding_ids",
        "description",
        "effect_on_confidence"
      ],
      "title": "Contradiction",
      "type": "object"
    },
    "EdgeType": {
      "description": "Finding\u2192finding edges Analysis may propose (\u00a79.3, \u00a712.3).",
      "enum": [
        "CORROBORATES",
        "CONTRADICTS",
        "DERIVED_FROM"
      ],
      "title": "EdgeType",
      "type": "string"
    },
    "FindingKind": {
      "description": "Finding kind (spec \u00a79.1, \u00a79.2): P0 folds \"Observation\" into Finding.",
      "enum": [
        "OBSERVATION",
        "INFERENCE"
      ],
      "title": "FindingKind",
      "type": "string"
    },
    "ProposedEdge": {
      "additionalProperties": false,
      "description": "``(source)-[:type]->(target)``. Shape is not in the spec (only the edge types are).",
      "properties": {
        "source_finding_id": {
          "pattern": "^fnd_[A-Za-z0-9_-]{1,64}$",
          "title": "Source Finding Id",
          "type": "string"
        },
        "target_finding_id": {
          "pattern": "^fnd_[A-Za-z0-9_-]{1,64}$",
          "title": "Target Finding Id",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/EdgeType"
        }
      },
      "required": [
        "type",
        "source_finding_id",
        "target_finding_id"
      ],
      "title": "ProposedEdge",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "``POST /v1/assessments`` body; idempotency key = ``task_id`` (\u00a78.5, ADR-003 B6).",
  "properties": {
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "conclusions": {
      "items": {
        "$ref": "#/$defs/Conclusion"
      },
      "minItems": 1,
      "title": "Conclusions",
      "type": "array"
    },
    "contradictions": {
      "items": {
        "$ref": "#/$defs/Contradiction"
      },
      "title": "Contradictions",
      "type": "array"
    },
    "follow_up_questions": {
      "description": "\u00a76.4; absent from the \u00a712.4 example.",
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Follow Up Questions",
      "type": "array"
    },
    "information_gaps": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Information Gaps",
      "type": "array"
    },
    "investigation_id": {
      "pattern": "^inv_[A-Za-z0-9_-]{1,64}$",
      "title": "Investigation Id",
      "type": "string"
    },
    "model_id": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Model Id",
      "type": "string"
    },
    "prompt_version": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Prompt Version",
      "type": "string"
    },
    "proposed_edges": {
      "items": {
        "$ref": "#/$defs/ProposedEdge"
      },
      "title": "Proposed Edges",
      "type": "array"
    },
    "schema_version": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "task_id": {
      "pattern": "^tsk_[A-Za-z0-9_-]{1,64}$",
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "summary",
    "conclusions",
    "model_id",
    "prompt_version",
    "task_id",
    "investigation_id",
    "attempt",
    "schema_version"
  ],
  "title": "AssessmentSubmission",
  "type": "object"
}
